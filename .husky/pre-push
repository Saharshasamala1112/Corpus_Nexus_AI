#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push checks..."

REPO_ROOT="$(cd "$(dirname -- "$0")/.." && pwd)"

# Backend: full lint + format check
echo "🧹 Backend ruff lint..."
cd "$REPO_ROOT/backend" && ruff check .

echo "📐 Backend ruff format check..."
cd "$REPO_ROOT/backend" && ruff format --check .

# Backend: pytest
echo "🧪 Backend tests..."
cd "$REPO_ROOT/backend" && python -m pytest tests/ -x -q --tb=short
if [ $? -ne 0 ]; then
  echo "❌ Backend tests failed"
  exit 1
fi

# Frontend: full lint
echo "🧹 Frontend ESLint..."
cd "$REPO_ROOT/frontend" && npx eslint .
if [ $? -ne 0 ]; then
  echo "❌ Frontend lint failed"
  exit 1
fi

# Frontend: format check
echo "📐 Frontend format check..."
cd "$REPO_ROOT/frontend" && npx prettier --check "src/**/*.{ts,tsx,css,json}"
if [ $? -ne 0 ]; then
  echo "❌ Frontend format check failed"
  exit 1
fi

# Frontend: typecheck
echo "📝 TypeScript typecheck..."
cd "$REPO_ROOT/frontend" && npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Frontend typecheck failed"
  exit 1
fi

# Frontend: tests
echo "🧪 Frontend tests..."
cd "$REPO_ROOT/frontend" && npx vitest run --reporter=verbose
if [ $? -ne 0 ]; then
  echo "❌ Frontend tests failed"
  exit 1
fi

echo "✅ All pre-push checks passed"
