#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push checks..."

# Full lint check
echo "🧹 ESLint full check..."
npx eslint .
if [ $? -ne 0 ]; then
  echo "❌ Lint failed"
  exit 1
fi

# Format check
echo "📐 Format check..."
npx prettier --check "src/**/*.{ts,tsx,css,json}"
if [ $? -ne 0 ]; then
  echo "❌ Format check failed"
  exit 1
fi

# Typecheck
echo "📝 TypeScript typecheck..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Typecheck failed"
  exit 1
fi

# Tests with coverage
echo "🧪 Running tests with coverage..."
npx vitest run --coverage
if [ $? -ne 0 ]; then
  echo "❌ Tests failed"
  exit 1
fi

echo "✅ All pre-push checks passed"
