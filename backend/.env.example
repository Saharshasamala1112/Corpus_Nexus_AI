# Application
APP_NAME=CorpusGuard AI Assistant
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./corpusguard.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
LLM_PROVIDER=ollama
OPENAI_API_KEY=
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# RAG / Knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_TYPE=in_memory
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
